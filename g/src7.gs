// ===== ログイン =====
function ハッシュ_(pw, salt) {
  const b = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, salt + '|' + pw, Utilities.Charset.UTF_8);
  return b.map(x => ('0' + (x & 255).toString(16)).slice(-2)).join('');
}
function 担当者一覧_() {
  const s = 本体_().getSheetByName('担当者');
  if (s.getRange(1, 7).getValue() !== '立場（管理者／担当者）') s.getRange(1, 7).setValue('立場（管理者／担当者）').setFontWeight('bold').setBackground('#fde7d3');
  return s.getRange(2, 1, Math.max(s.getLastRow() - 1, 1), 7).getValues().map((r, i) => ({ 行: i + 2, id: String(r[0]).trim(), 名前: r[1], メール: r[2], 初期: String(r[3]), 暗号: String(r[4]), 有効: r[5] !== '停止', 立場: String(r[6] || '').trim() === '管理者' || String(r[0]).trim() === 'admin' ? '管理者' : '担当者' })).filter(x => x.id);
}
function login(id, pw) {
  id = String(id || '').trim(); pw = String(pw || '');
  const cache = CacheService.getScriptCache();
  const 失敗キー = 'fail_' + Utilities.base64EncodeWebSafe(id);
  const 失敗 = Number(cache.get(失敗キー) || 0);
  if (失敗 >= 5) return { ok: false, error: 'ログインに続けて失敗したため、15分間ログインできません。' };
  const u = 担当者一覧_().find(x => x.id === id && x.有効);
  let ok = false;
  if (u) {
    if (u.暗号) {
      const [salt, h] = u.暗号.split(':');
      ok = ハッシュ_(pw, salt) === h;
    } else if (u.初期 && u.初期.length >= 8 && pw === u.初期) {
      ok = true;
      const salt = Utilities.getUuid();
      const s = 本体_().getSheetByName('担当者');
      s.getRange(u.行, 5).setValue(salt + ':' + ハッシュ_(pw, salt));
      s.getRange(u.行, 4).setValue('');
    }
  }
  if (!ok) { cache.put(失敗キー, String(失敗 + 1), 900); return { ok: false, error: 'IDまたはパスワードが違います。' }; }
  cache.remove(失敗キー);
  const token = Utilities.getUuid() + Utilities.getUuid();
  cache.put('sess_' + token, JSON.stringify({ id: u.id, 名前: u.名前 || u.id, 立場: u.立場 }), 8 * 3600);
  ログ_({ 名前: u.名前 || u.id }, '-', 'ログイン', '', '', '');
  return { ok: true, token: token, 名前: u.名前 || u.id, 立場: u.立場 };
}
function logout(token) { CacheService.getScriptCache().remove('sess_' + token); return { ok: true }; }
function 確認_(token) {
  const c = CacheService.getScriptCache();
  const v = c.get('sess_' + token);
  if (!v) throw new Error('ログインの有効時間が切れました。もう一度ログインしてください。');
  c.put('sess_' + token, v, 8 * 3600); // 使っている間は延長
  const me = JSON.parse(v);
  if (!me.立場) { const u = 担当者一覧_().find(x => x.id === me.id); me.立場 = u ? u.立場 : '担当者'; }
  return me;
}
function 管理者_(token) { const me = 確認_(token); if (me.立場 !== '管理者') throw new Error('この操作は管理者だけができます。'); return me; }
// 担当者は、自分が担当の案件と、担当が決まっていない案件だけを扱える
function 扱える_(me, 担当) { return me.立場 === '管理者' || !担当 || 担当 === me.名前; }
function 案件の担当_(番号) { const sh = 一覧_(); const v = sh.getRange(2, 列.番号, Math.max(sh.getLastRow() - 1, 1), 1).getValues(); const i = v.findIndex(r => r[0] === 番号); if (i < 0) throw new Error('案件が見つかりません'); return { 行: i + 2, 担当: String(sh.getRange(i + 2, 列.担当者).getValue() || ''), 区分: 区分_(sh.getRange(i + 2, 列.相談).getValue(), sh.getRange(i + 2, 列.分野).getValue()) }; }
function 権限確認_(me, 番号) { const a = 案件の担当_(番号); if (!扱える_(me, a.担当)) throw new Error('この案件は担当ではないため操作できません。'); return a; }

// ===== 対応ログ（すべての操作を1行ずつ残し、消さない） =====
const ログ見出し = ['日時', '受付番号', '種類', '内容', '担当', '操作した人', '区分'];
function ログ_(me, 番号, 種類, 内容, 担当, 区分) {
  try { シート_('対応ログ', ログ見出し).appendRow([今_(), 番号 || '-', 種類, String(内容 || '').slice(0, 2000), 担当 || '', (me && me.名前) || '', 区分 || '']); } catch (_) { }
}
function getLog(token, f) {
  管理者_(token); f = f || {};
  const s = シート_('対応ログ', ログ見出し); const n = s.getLastRow(); if (n < 2) return [];
  const from = String(f.from || '').replace(/-/g, '/'), to = String(f.to || '').replace(/-/g, '/');
  return s.getRange(Math.max(2, n - 4999), 1, Math.min(n - 1, 5000), 7).getValues().map(r => ({ 日時: 書式_(r[0]) || String(r[0]), 番号: r[1], 種類: r[2], 内容: r[3], 担当: r[4], 人: r[5], 区分: r[6] }))
    .filter(x => (!from || x.日時.slice(0, 10) >= from) && (!to || x.日時.slice(0, 10) <= to) && (!f.区分 || x.区分 === f.区分) && (!f.種類 || x.種類 === f.種類) && (!f.人 || x.人 === f.人)).reverse();
}

// ===== 設定：担当者のアカウント（管理者のみ） =====
function listStaff(token) { 管理者_(token); return 担当者一覧_().map(x => ({ 行: x.行, id: x.id, 名前: x.名前, メール: x.メール, 立場: x.立場, 有効: x.有効, 初期設定待ち: !x.暗号 })); }
// d: { 行(更新時), id, 名前, メール, 立場, 有効, 初期パスワード(任意・入れたら初期化) }
function saveStaff(token, d) {
  const me = 管理者_(token);
  const s = 本体_().getSheetByName('担当者'); const 一覧 = 担当者一覧_();
  const id = String(d.id || '').trim(), 名前 = String(d.名前 || '').trim();
  if (!/^[A-Za-z0-9._-]{3,30}$/.test(id)) return { ok: false, error: 'ログインIDは半角英数字3〜30文字にしてください。' };
  if (!名前) return { ok: false, error: '名前を入れてください。' };
  if (一覧.some(x => x.id === id && x.行 !== Number(d.行))) return { ok: false, error: '同じログインIDがすでにあります。' };
  const pw = String(d.初期パスワード || '');
  if (pw && pw.length < 8) return { ok: false, error: '初期パスワードは8文字以上にしてください。' };
  const 立場 = d.立場 === '管理者' ? '管理者' : '担当者';
  if (d.行) {
    const 前 = 一覧.find(x => x.行 === Number(d.行)); if (!前) return { ok: false, error: '担当者が見つかりません。' };
    if (前.id === me.id && (立場 !== '管理者' || d.有効 === false)) return { ok: false, error: '自分自身の管理者の権限や利用は外せません。' };
    s.getRange(前.行, 1, 1, 3).setValues([[id, 名前, String(d.メール || '').trim()]]);
    s.getRange(前.行, 6, 1, 2).setValues([[d.有効 === false ? '停止' : '有効', 立場]]);
    if (pw) { s.getRange(前.行, 4).setValue(pw); s.getRange(前.行, 5).setValue(''); }
    ログ_(me, '-', '担当者の変更', id + '（' + 名前 + '）' + (pw ? '／パスワードを初期化' : '') + (d.有効 === false ? '／停止' : ''), '', '');
  } else {
    if (!pw) return { ok: false, error: '新しい担当者には初期パスワードを入れてください。' };
    s.appendRow([id, 名前, String(d.メール || '').trim(), pw, '', d.有効 === false ? '停止' : '有効', 立場]);
    ログ_(me, '-', '担当者の追加', id + '（' + 名前 + '・' + 立場 + '）', '', '');
  }
  return { ok: true };
}
function changePassword(token, 今の, 新しい) {
  const me = 確認_(token);
  新しい = String(新しい || '');
  if (新しい.length < 8) return { ok: false, error: '新しいパスワードは8文字以上にしてください。' };
  const u = 担当者一覧_().find(x => x.id === me.id);
  const [salt, h] = (u.暗号 || ':').split(':');
  if (ハッシュ_(String(今の || ''), salt) !== h) return { ok: false, error: '今のパスワードが違います。' };
  const ns = Utilities.getUuid();
  本体_().getSheetByName('担当者').getRange(u.行, 5).setValue(ns + ':' + ハッシュ_(新しい, ns));
  return { ok: true };
}

// ===== 案件の一覧（新しい順） =====
function 案件_(r, i, 設) {
  const now = Date.now();
  const 受付 = 日付_(r[列.日時 - 1]);
  const 最終対応 = 日付_(r[列.最終対応 - 1]) || 受付;
  const 最終報告 = 日付_(r[列.最終報告 - 1]);
  const 期日 = 日付_(r[列.期日 - 1]);
  const 区分 = 区分_(r[列.相談 - 1], r[列.分野 - 1]); const 定 = 区分定義[区分];
  let 状況 = String(r[列.状況 - 1] || '未対応');
  if (旧段階[状況] && 区分 === '経営相談') 状況 = 旧段階[状況];
  if (定.段階.indexOf(状況) < 0) 状況 = '未対応';
  const 経過 = 最終対応 ? (now - 最終対応.getTime()) / 3600000 : 0;
  const 受付から = 受付 ? (now - 受付.getTime()) / 3600000 : 0;
  const 進行中 = 定.終了.indexOf(状況) < 0;
  let 警告 = '';
  if (状況 === '未対応' && 受付から >= 設.未対応時間) 警告 = '未対応';
  else if (進行中 && 期日 && 期日.getTime() < now) 警告 = '期日超過';
  else if (進行中 && 状況 !== '未対応' && 定.待機.indexOf(状況) < 0 && 経過 >= 設.放置日 * 24) 警告 = '進捗の記録なし';
  const 連絡から = 最終報告 ? (now - 最終報告.getTime()) / 3600000 : 受付から;
  return {
    行: i + 2, 番号: r[列.番号 - 1], 受付: 書式_(受付), 名前: r[列.名前 - 1], 会社: r[列.会社 - 1], メール: r[列.メール - 1], 電話: String(r[列.電話 - 1] || ''),
    相談: r[列.相談 - 1], 本文: r[列.本文 - 1], 状況: 状況, 区分: 区分, 契約番号: String(r[列.契約番号 - 1] || ''), 契約状態: String(r[列.契約状態 - 1] || ''), 分野: r[列.分野 - 1], 小分類: r[列.小分類 - 1], 振分け先: 定.自社のみ ? '自社' : (r[列.振分け先 - 1] || '自社（未割当）'),
    担当者: r[列.担当者 - 1], 最終対応: 書式_(最終対応), 最終報告: 書式_(最終報告), 報告回数: Number(r[列.報告回数 - 1] || 0), メモ: r[列.メモ - 1],
