function 定型文_(c, 状況, 伝える, 次, 担当名) {
  const 宛名 = (c.会社 ? c.会社 + '\n' : '') + c.名前 + ' 様';
  const 件 = String(c.分野 || c.相談 || 'お問い合わせ').split('＞').pop().trim();
