// ===== setup（初期設定）：記録用のスプレッドシートと、管理に使うシートを作ります =====
function setup() {
  const props = PropertiesService.getScriptProperties();
  let id = props.getProperty('SHEET_ID');
  let ss;
  if (!id) {
    ss = SpreadsheetApp.create('ホームページお問い合わせ一覧（' + 会社名 + '）');
    id = ss.getId();
    props.setProperty('SHEET_ID', id);
    ss.getSheets()[0].setName(シート名);
  } else {
    ss = SpreadsheetApp.openById(id);
  }
  const sh = ss.getSheetByName(シート名) || ss.insertSheet(シート名);
  sh.getRange(1, 1, 1, 見出し.length).setValues([見出し]).setFontWeight('bold').setBackground('#fde7d3');
  sh.setFrozenRows(1);
  準備_(true);
  const ps = シート_('振分け先', ['大分類', '中分類', '小分類（空欄＝その中分類すべて）', '振分け先', '振分け先の連絡先メール', '備考']);
  if (ps.getLastRow() < 2) ps.getRange(2, 1, 振分け初期.length, 4).setValues(振分け初期);
  const st = シート_('担当者', ['ログインID', 'お名前', 'メール', '初期パスワード（入力後、初回ログインで自動的に消えます）', 'パスワード（暗号化済み・触らない）', '利用']);
  if (st.getLastRow() < 2) st.appendRow(['admin', '管理者', 通知先, '', '', '有効']);
  const cf = シート_('設定', ['項目', '値', '説明']);
  if (cf.getLastRow() < 2) cf.getRange(2, 1, 4, 3).setValues([
    ['未対応の警告（時間）', 24, '受付からこの時間がたっても「未対応」のままなら警告'],
    ['放置の警告（日）', 3, '最後の対応からこの日数、進捗の記録がなければ警告'],
    ['お客さまへの連絡の目安（日）', 7, '最後の連絡からこの日数たつと「連絡のめやす」を表示（送るかは担当者が判断）'],
    ['連絡の間隔の下限（時間）', 24, 'これより短い間隔で送ろうとすると確認を出す（連絡しすぎ防止）']]);
  番号を付ける_(sh);
  // 1時間ごとの警告メール
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === '定期確認').forEach(t => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('定期確認').timeBased().everyHours(1).create();
  Logger.log('準備完了。記録先：https://docs.google.com/spreadsheets/d/' + id);
  Logger.log('次に「担当者」シートの admin の行の「初期パスワード」欄に、8文字以上のパスワードを入力してください。');
}

function シート_(名前, 見出し行) {
  const ss = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID'));
  let s = ss.getSheetByName(名前);
  if (!s) {
    s = ss.insertSheet(名前);
    s.getRange(1, 1, 1, 見出し行.length).setValues([見出し行]).setFontWeight('bold').setBackground('#fde7d3');
    s.setFrozenRows(1);
  }
  return s;
}
// 第5版で増えたシート・列を用意する（setupをやり直さなくても、管理画面を開いたときに自動で用意）
function 準備_(強制) {
  const c = CacheService.getScriptCache();
  if (!強制 && c.get('prep_v5')) return;
  const ss = 本体_();
  const sh = ss.getSheetByName(シート名);
  if (sh && sh.getRange(1, 列.進捗小).getValue() !== 見出し[列.進捗小 - 1]) sh.getRange(1, 1, 1, 見出し.length).setValues([見出し]).setFontWeight('bold').setBackground('#fde7d3');
  const h = シート_('対応履歴', 履歴見出し);
  if (h.getRange(1, 10).getValue() !== '金額') h.getRange(1, 1, 1, 履歴見出し.length).setValues([履歴見出し]).setFontWeight('bold').setBackground('#fde7d3');
  シート_('取次先', 取次先見出し);
  const o = シート_('進捗の選択肢', ['進み具合（大分類）', '中分類', '小分類（「／」区切り）']);
  if (o.getLastRow() < 2) o.getRange(2, 1, 進捗選択肢初期.length, 3).setValues(進捗選択肢初期);
  c.put('prep_v5', '1', 21600);
}
function 選択肢_() {
  const o = 本体_().getSheetByName('進捗の選択肢');
  const v = o && o.getLastRow() > 1 ? o.getRange(2, 1, o.getLastRow() - 1, 3).getValues() : 進捗選択肢初期;
  const r = {};
  段階.forEach(d => r[d] = []);
  v.forEach(x => { const d = String(x[0]).trim(), m = String(x[1]).trim(); if (!r[d] || !m) return; r[d].push({ 中: m, 小: String(x[2] || '').split(/[／\/、,]/).map(t => t.trim()).filter(Boolean) }); });
  return r;
}
function 本体_() { return SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID')); }
function 一覧_() { return 本体_().getSheetByName(シート名); }
function 今_() { return Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm'); }
function 日付_(v) {
  if (v instanceof Date) return v;
  if (!v) return null;
  const m = String(v).match(/(\d{4})\D(\d{1,2})\D(\d{1,2})(?:\D+(\d{1,2}):(\d{2}))?/);
  if (!m) return null;
  // 日本時間として読む
  return new Date(Date.UTC(+m[1], +m[2] - 1, +m[3], +(m[4] || 0), +(m[5] || 0)) - 9 * 3600000);
}
function 書式_(v) { const d = 日付_(v); return d ? Utilities.formatDate(d, 'Asia/Tokyo', 'yyyy/MM/dd HH:mm') : ''; }

function 設定_() {
  const 既定 = { 未対応時間: 24, 放置日: 3, 連絡目安日: 7, 連絡下限時間: 24 };
  const s = 本体_().getSheetByName('設定');
  if (!s || s.getLastRow() < 2) return 既定;
  const v = s.getRange(2, 1, s.getLastRow() - 1, 2).getValues();
  const 取 = (名, 既) => { const r = v.find(x => x[0] === 名); const n = r ? Number(r[1]) : NaN; return n > 0 ? n : 既; };
  return { 未対応時間: 取('未対応の警告（時間）', 24), 放置日: 取('放置の警告（日）', 3), 連絡目安日: 取('お客さまへの連絡の目安（日）', 7), 連絡下限時間: 取('連絡の間隔の下限（時間）', 24) };
}

// ===== 振分け：お客さまが選んだ分野・小分類から、振分け先を決める =====
function 振分け_(分野, 小分類) {
  const 中 = String(分野 || '').split('＞').map(s => s.trim()).pop() || '';
  const 小 = String(小分類 || '').split('、').map(s => s.trim()).filter(Boolean);
  const s = 本体_().getSheetByName('振分け先');
  const v = s && s.getLastRow() > 1 ? s.getRange(2, 1, s.getLastRow() - 1, 4).getValues() : 振分け初期;
  const 先 = [];
  v.forEach(r => { if (r[1] === 中 && r[2] && 小.indexOf(r[2]) >= 0 && r[3] && 先.indexOf(r[3]) < 0) 先.push(r[3]); });
  if (!先.length) v.forEach(r => { if (r[1] === 中 && !r[2] && r[3] && 先.indexOf(r[3]) < 0) 先.push(r[3]); });
  return 先.length ? 先.join('／') : '自社（未割当）';
}

// 番号のない行（以前の受付分）に案件番号と振分け先を付ける
function 番号を付ける_(sh) {
  const n = sh.getLastRow();
  if (n < 2) return;
  const v = sh.getRange(2, 1, n - 1, 見出し.length).getValues();
  v.forEach((r, i) => {
    if (r[列.番号 - 1]) return;
    const d = 日付_(r[0]) || new Date();
    sh.getRange(i + 2, 列.番号).setValue('MA-' + Utilities.formatDate(d, 'Asia/Tokyo', 'yyMMdd') + '-' + (i + 2));
    if (!r[列.振分け先 - 1]) sh.getRange(i + 2, 列.振分け先).setValue(振分け_(r[列.分野 - 1], r[列.小分類 - 1]));
    if (!r[列.状況 - 1]) sh.getRange(i + 2, 列.状況).setValue('未対応');
  });
}

// ===== ホームページからの送信を受け取る =====
function doPost(e) {
  const p = (e && e.parameter) || {};
  const 返す = (obj) => ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
  if (p.api) return 管理API_(p);
  if (p.pub === 'invite' || p.pub === 'register') return 招待API_(p);
  try {
    if (p._honey) return 返す({ ok: true });
    const 名前 = String(p.name || '').trim().slice(0, 100);
    const メール = String(p.email || '').trim().slice(0, 200);
    const 本文 = String(p.message || '').trim().slice(0, 5000);
    if (!名前 || !メール || !本文 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(メール)) return 返す({ ok: false, error: '入力内容に不足があります' });
    const cache = CacheService.getScriptCache();
    const key = 'last_' + Utilities.base64EncodeWebSafe(メール);
    if (cache.get(key)) return 返す({ ok: false, error: '短時間に続けて送信されています' });
    cache.put(key, '1', 60);

    const 会社 = String(p.company || '').trim().slice(0, 100);
    const 電話番号 = String(p.tel || '').trim().slice(0, 40);
    const 相談 = String(p.topic || '').trim().slice(0, 300);
    const 分野 = String(p.cat || '').trim().slice(0, 200);
    const 小分類 = String(p.subs || '').trim().slice(0, 1000);
    const 日時 = 今_();
    let 番号 = '', 振分け先 = '';

    // 1) 記録（案件番号・振分け先を付ける）
    if (PropertiesService.getScriptProperties().getProperty('SHEET_ID')) {
      const lock = LockService.getScriptLock();
      lock.waitLock(20000);
      try {
        const sh = 一覧_();
        const 行 = sh.getLastRow() + 1;
        番号 = 'MA-' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyMMdd') + '-' + 行;
        振分け先 = 自動振分け_(分野, 小分類, 本文, 会社);
        const r = new Array(見出し.length).fill('');
        r[列.日時 - 1] = 日時; r[列.名前 - 1] = 名前; r[列.会社 - 1] = 会社; r[列.メール - 1] = メール; r[列.電話 - 1] = 電話番号;
        r[列.相談 - 1] = 相談; r[列.本文 - 1] = 本文; r[列.状況 - 1] = '未対応'; r[列.分野 - 1] = 分野; r[列.小分類 - 1] = 小分類;
        r[列.番号 - 1] = 番号; r[列.振分け先 - 1] = 振分け先; r[列.最終対応 - 1] = 日時; r[列.報告回数 - 1] = 0;
        sh.getRange(行, 1, 1, r.length).setNumberFormat('@').setValues([r]);
        本体_().getSheetByName('対応履歴').appendRow([日時, 番号, 'ホームページ', '受付', '未対応', '振分け先：' + 振分け先, '受付メール（自動）']);
      } finally { lock.releaseLock(); }
    }

    // 2) 社内への通知
    const 内容 = 'お名前：' + 名前 + '\n会社名：' + 会社 + '\nメール：' + メール + '\n電話：' + 電話番号 + '\n相談したい内容：' + 相談 + '\n\n【ご相談内容】\n' + 本文;
    MailApp.sendEmail({
      to: 通知先, replyTo: メール, name: 会社名 + ' ホームページ',
      subject: '【ホームページからのご相談】' + (番号 ? '[' + 番号 + '] ' : '') + 名前 + '様（' + (相談 || 'お問い合わせ') + '）',
      body: 'ホームページのフォームからお問い合わせがありました（' + 日時 + '）。\n'
        + (振分け先 ? '振分け先：' + 振分け先 + '\n' : '')
        + 'このメールに返信すると、お客さまへ直接返信できます。案件の進み具合は管理画面で記録してください。\n'
        + (管理画面URL_() ? '管理画面：' + 管理画面URL_() + '\n' : '') + '\n' + 内容
    });

    // 3) お客さまへの自動返信
    MailApp.sendEmail({
      to: メール, replyTo: 通知先, name: 会社名,
      subject: '【' + 会社名 + '】お問い合わせを受け付けました' + (番号 ? '（受付番号 ' + 番号 + '）' : ''),
      body: 名前 + ' 様\n\n'
        + 'このたびは' + 会社名 + 'へお問い合わせいただき、誠にありがとうございます。\n'
        + '下記の内容で受け付けました。内容を確認のうえ、担当者よりご連絡いたします。\n'
        + (番号 ? '受付番号：' + 番号 + '（お問い合わせの際にお伝えください）\n' : '')
        + 'お急ぎの場合は、お電話（' + 電話 + '／受付 ' + 受付時間 + '）でもお問い合わせいただけます。\n\n'
        + '────────────────\n' + 内容 + '\n────────────────\n\n'
        + '※このメールは自動で送信しています。お心当たりのない場合は、お手数ですが本メールを削除してください。\n\n'
        + 署名_()
    });
    return 返す({ ok: true });
  } catch (err) {
    return 返す({ ok: false, error: String(err) });
  }
}
function 署名_() { return 会社名 + '\n' + 所在地 + '\n電話 ' + 電話 + '　メール ' + 通知先; }
function 管理画面URL_() { return 'https://madvi.jp/kanri/'; }

