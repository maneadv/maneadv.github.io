    前回連絡: c.最終報告 || '（まだ連絡していません）', 担当: 担当名, 担当一覧: 担当一覧, 連絡からの時間: c.連絡からの時間, 下限: 設.連絡下限時間, 報告回数: c.報告回数 };
}
// 担当者が「送る」を押したときだけ送る
function sendReport(token, 番号, 件名, 本文, 状況, 担当名) {
  const me = 確認_(token); const 権 = 権限確認_(me, 番号);
  const sh = 一覧_();
  const v = sh.getRange(2, 列.番号, Math.max(sh.getLastRow() - 1, 1), 1).getValues();
  const i = v.findIndex(r => r[0] === 番号);
  if (i < 0) throw new Error('案件が見つかりません');
  const 行 = i + 2;
  const 宛先 = sh.getRange(行, 列.メール).getValue();
  本文 = String(本文 || '').trim();
  if (!本文) throw new Error('本文が空です');
  // 選んだ担当者の名前で送る。担当者のメールが登録されていれば、お客さまの返信はその担当者と通知先の両方に届く
  担当名 = String(担当名 || me.名前).trim();
  const 担当 = 担当者一覧_().find(x => (x.名前 || x.id) === 担当名);
  const 担当メール = 担当 && /@/.test(String(担当.メール)) ? String(担当.メール).trim() : '';
  const 返信先 = 担当メール && 担当メール !== 通知先 ? 担当メール + ',' + 通知先 : 通知先;
  const 送信 = { to: 宛先, replyTo: 返信先, name: 会社名 + '（担当：' + 担当名 + '）', subject: String(件名 || '').slice(0, 200), body: 本文 };
  if (担当メール && 担当メール !== 通知先) 送信.cc = 担当メール; // 担当者にも控えを送る
  MailApp.sendEmail(送信);
  if (担当名) sh.getRange(行, 列.担当者).setValue(担当名);
  sh.getRange(行, 列.最終報告).setNumberFormat('@').setValue(今_());
  sh.getRange(行, 列.最終対応).setNumberFormat('@').setValue(今_());
  sh.getRange(行, 列.報告回数).setValue(Number(sh.getRange(行, 列.報告回数).getValue() || 0) + 1);
  本体_().getSheetByName('対応履歴').appendRow([今_(), 番号, me.名前, 'お客さまへ報告', 状況 || sh.getRange(行, 列.状況).getValue(), '担当：' + 担当名 + '\n' + 本文, '送信済み']);
  ログ_(me, 番号, 'お客さまへ報告', '件名：' + String(件名 || '').slice(0, 100) + '／宛先：' + 宛先, 担当名, 権.区分);
  return { ok: true };
}

