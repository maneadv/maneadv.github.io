      if (n > 1) { const v = sh.getRange(2, 列.振分け先, n - 1, 1).getValues(); v.forEach((r, i) => { const a = String(r[0]).split('／'); const k = a.indexOf(前.名前); if (k >= 0) { a[k] = 名前; sh.getRange(i + 2, 列.振分け先).setValue(a.join('／')); } }); }
    }
  } else {
    s.appendRow(行値.concat([今_().slice(0, 10), me.名前, '管理画面']));
  }
  本体_().getSheetByName('対応履歴').appendRow([今_(), '-', me.名前, '取次先の登録', '', (p.行 ? '更新：' : '追加：') + 名前, '', '', '', '']);
  ログ_(me, '-', p.行 ? '取次先の変更' : '取次先の登録', 名前 + (p.確認待ち ? '（確認待ち）' : p.有効 === false ? '（停止）' : ''), '', '');
  return { ok: true };
}
function 取次実績_() {
  const sh = 一覧_(); const n = sh.getLastRow(); const r = {};
  if (n < 2) return r;
  sh.getRange(2, 1, n - 1, 見出し.length).getValues().forEach(x => {
    const 状 = 旧段階[x[列.状況 - 1]] || x[列.状況 - 1];
    String(x[列.振分け先 - 1] || '').split('／').forEach(p => { if (!p) return; r[p] = r[p] || { 件数: 0, 完了: 0 }; r[p].件数++; if (状 === '完了' && !/見送り|失注|対応できない|連絡がつかない/.test(x[列.進捗中 - 1])) r[p].完了++; });
  });
  return r;
}
function 正規_(t) { return String(t || '').normalize('NFKC').toLowerCase().replace(/\s+/g, ''); }
function 区切り_(t) { return String(t || '').split(/[、,，／\/\n]/).map(x => x.trim()).filter(Boolean); }
// お問い合わせの内容から、取次先の候補を点数順に出す
function 候補_(分野, 小分類, 本文, 会社, 一覧, 実績) {
  const 部 = String(分野 || '').split('＞').map(x => x.trim());
  const 中 = 部[部.length - 1] || '', 大 = 部.length > 1 ? 部[0] : '';
  const 小 = 区切り_(小分類).map(正規_);
  const 文 = 正規_([本文, 会社, 小分類].join(' '));
  const 結果 = [];
  一覧.forEach(p => {
    if (!p.有効) return;
    let 点 = 0; const 理由 = [];
    const 分野 = 区切り_(p.分野);
    if (分野.indexOf('すべて') >= 0) { 点 += 10; 理由.push('全分野に対応'); }
    else if (中 && 分野.some(a => a === 中 || 中.indexOf(a) >= 0 || a.indexOf(中) >= 0)) { 点 += 50; 理由.push('分野が一致：' + 中); }
    else if (大 && 分野.some(a => a === 大)) { 点 += 25; 理由.push('分類が一致：' + 大); }
    let 語 = 0;
    区切り_(p.キーワード).forEach(k => {
      const kk = 正規_(k); if (!kk || 語 >= 5) return;
      if (小.some(x => x.indexOf(kk) >= 0 || kk.indexOf(x) >= 0)) { 点 += 15; 語++; 理由.push('選ばれた内容に「' + k + '」'); }
      else if (文.indexOf(kk) >= 0) { 点 += 8; 語++; 理由.push('相談文に「' + k + '」'); }
    });
    if (!点) return;
    const 地 = 区切り_(p.地域).filter(a => a !== '全国' && 文.indexOf(正規_(a)) >= 0);
    if (地.length) { 点 += 5; 理由.push('地域：' + 地[0]); }
    const 実 = 実績[p.名前];
    if (実 && 実.完了) { 点 += Math.min(10, 実.完了 * 2); 理由.push('取次の完了実績 ' + 実.完了 + '件'); }
    結果.push({ 名前: p.名前, 種別: p.種別, 担当者: p.担当者, メール: p.メール, 電話: p.電話, 条件: p.条件, 点: Math.min(99, 点), 理由: 理由 });
  });
  結果.sort((a, b) => b.点 - a.点);
  return 結果.slice(0, 5);
}
function 自動振分け_(分野, 小分類, 本文, 会社) {
  try {
    const c = 候補_(分野, 小分類, 本文, 会社, 取次先一覧_(), {});
    if (c.length && c[0].点 >= 50) return c[0].名前;
  } catch (_) { }
  return 振分け_(分野, 小分類);
}
function suggestPartners(token, 番号) {
  確認_(token);
  const sh = 一覧_(); const 設 = 設定_();
  const v = sh.getRange(2, 1, Math.max(sh.getLastRow() - 1, 1), 見出し.length).getValues();
  const i = v.findIndex(r => r[列.番号 - 1] === 番号);
  if (i < 0) throw new Error('案件が見つかりません');
  const c = 案件_(v[i], i, 設);
  const 一覧 = 取次先一覧_();
  return { 候補: 候補_(c.分野, c.小分類, c.本文, c.会社, 一覧, 取次実績_()), 登録数: 一覧.filter(p => p.有効).length, 目安: 振分け_(c.分野, c.小分類) };
}

// ===== 取次先への連絡（下書き → 担当者が送るか決める） =====
function draftReferral(token, 番号, 取次先名, 連絡先を含める, 担当名) {
  const me = 確認_(token); 権限確認_(me, 番号);
  const sh = 一覧_(); const 設 = 設定_();
  const v = sh.getRange(2, 1, Math.max(sh.getLastRow() - 1, 1), 見出し.length).getValues();
  const i = v.findIndex(r => r[列.番号 - 1] === 番号);
  if (i < 0) throw new Error('案件が見つかりません');
  const c = 案件_(v[i], i, 設);
  const p = 取次先一覧_().find(x => x.名前 === 取次先名);
  if (!p) throw new Error('取次先「' + 取次先名 + '」が登録されていません。');
  担当名 = String(担当名 || c.担当者 || me.名前);
  const 件 = String(c.分野 || c.相談 || 'ご相談').split('＞').pop().trim();
  let 文 = 取次先名 + '\n' + (p.担当者 ? p.担当者 + ' 様' : 'ご担当者 様') + '\n\nいつもお世話になっております。' + 会社名 + 'の' + 担当名 + 'です。\n'
    + '下記のご相談について、貴社でご対応いただけないかご相談させてください。\n\n'
    + '【受付番号】' + c.番号 + '\n【分野】' + (c.分野 || c.相談 || '') + '\n【くわしい内容】' + (c.小分類 || '') + '\n\n【ご相談の内容】\n'
    + String(c.本文 || '').replace(/^【ご相談の分野】.*\n?/m, '').replace(/^【くわしい内容】.*\n?/m, '').trim() + '\n';
  文 += 連絡先を含める
    ? '\n【お客さま】\n' + (c.会社 ? c.会社 + '　' : '') + c.名前 + ' 様\nメール：' + c.メール + (c.電話 ? '\n電話：' + c.電話 : '') + '\n（ご連絡先をお伝えすることについて、お客さまの了承を得ています）\n'
    : '\n【お客さま】\nご対応いただける場合、お客さまの了承を得たうえで、ご連絡先をお伝えします。\n';
  if (p.条件) 文 += '\n【取次の条件】' + p.条件 + '\n';
  文 += '\nご対応の可否と、可能な場合の日程の目安を、このメールへのご返信でお知らせください。\nどうぞよろしくお願いいたします。\n\n────────────────\n' + 署名_() + '\n担当：' + 担当名;
  const 担当一覧 = 担当者一覧_().filter(x => x.有効).map(x => x.名前 || x.id);
  if (担当一覧.indexOf(担当名) < 0) 担当一覧.push(担当名);
  return { 宛先: p.メール, 取次先: 取次先名, 件名: '【取次のご相談】' + 件 + '（受付番号 ' + c.番号 + '）', 本文: 文, 担当: 担当名, 担当一覧: 担当一覧, 連絡先: !!連絡先を含める };
}
function sendReferral(token, 番号, 取次先名, 件名, 本文, 担当名, 同意) {
  const me = 確認_(token); const 権 = 権限確認_(me, 番号);
  if (同意 !== true) throw new Error('お客さまから、この取次先に情報を渡す同意を得たことを確認してください。');
  const p = 取次先一覧_().find(x => x.名前 === 取次先名 && x.有効);
  if (!p || !p.メール) throw new Error('取次先のメールアドレスが登録されていません。「取次先の登録」で入れてください。');
  本文 = String(本文 || '').trim(); if (!本文) throw new Error('本文が空です');
  担当名 = String(担当名 || me.名前).trim();
  const 担 = 担当者一覧_().find(x => (x.名前 || x.id) === 担当名);
  const 担当メール = 担 && /@/.test(String(担.メール)) ? String(担.メール).trim() : '';
  const 送信 = { to: p.メール, replyTo: 担当メール && 担当メール !== 通知先 ? 担当メール + ',' + 通知先 : 通知先, name: 会社名 + '（担当：' + 担当名 + '）', subject: String(件名 || '').slice(0, 200), body: 本文 };
  if (担当メール && 担当メール !== 通知先) 送信.cc = 担当メール;
  MailApp.sendEmail(送信);
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const sh = 一覧_();
    const v = sh.getRange(2, 列.番号, Math.max(sh.getLastRow() - 1, 1), 1).getValues();
    const i = v.findIndex(r => r[0] === 番号); if (i < 0) throw new Error('案件が見つかりません');
    const 行 = i + 2;
    const r = sh.getRange(行, 1, 1, 見出し.length).getValues()[0];
    const 前 = 旧段階[r[列.状況 - 1]] || r[列.状況 - 1] || '未対応';
    const 先 = String(r[列.振分け先 - 1] || '').split('／').filter(x => x && !/未設定|未割当/.test(x));
    if (先.indexOf(取次先名) < 0) { 先.push(取次先名); sh.getRange(行, 列.振分け先).setValue(先.join('／')); }
    let 状 = 前;
    if (段階.indexOf(前) < 段階.indexOf('対応先取次')) { 状 = '対応先取次'; sh.getRange(行, 列.状況).setValue(状); sh.getRange(行, 列.進捗中).setValue('取次先へ連絡'); sh.getRange(行, 列.進捗小).setValue('連絡済み・返答待ち'); }
    if (!r[列.担当者 - 1]) sh.getRange(行, 列.担当者).setValue(担当名);
    sh.getRange(行, 列.最終対応).setNumberFormat('@').setValue(今_());
    本体_().getSheetByName('対応履歴').appendRow([今_(), 番号, me.名前, '取次先へ連絡', 状, '取次先：' + 取次先名 + '（' + p.メール + '）／担当：' + 担当名 + '\n' + 本文, '取次先へ送信済み', 状 === 前 ? '' : '取次先へ連絡', 状 === 前 ? '' : '連絡済み・返答待ち', '']);
    ログ_(me, 番号, '取次先へ送付', '送り先：' + 取次先名 + '（' + p.メール + '）／お客さまの同意あり', 担当名, 権.区分);
  } finally { lock.releaseLock(); }
  return { ok: true };
}

// ===== 1時間ごと：警告がある案件を通知先へメール（1件につき1日1回まで） =====
function 定期確認() {
  const sh = 一覧_(); const 設 = 設定_();
  const n = sh.getLastRow(); if (n < 2) return;
  const v = sh.getRange(2, 1, n - 1, 見出し.length).getValues();
  const 対象 = [];
  v.forEach((r, i) => {
    const c = 案件_(r, i, 設);
    if (!c.警告) return;
    const 前 = 日付_(r[列.最終警告 - 1]);
    if (前 && Date.now() - 前.getTime() < 24 * 3600000) return;
    対象.push(c);
    sh.getRange(i + 2, 列.最終警告).setNumberFormat('@').setValue(今_());
  });
  if (!対象.length) return;
  const 行 = 対象.map(c => '・[' + c.番号 + '] ' + c.名前 + '様／' + c.警告 + '（' + 時間表記_(c.放置時間) + '）／振分け先：' + c.振分け先 + '／担当：' + (c.担当者 || '未定'));
  MailApp.sendEmail({ to: 通知先, name: 会社名 + ' 案件管理', subject: '【要対応】放置されている案件が ' + 対象.length + ' 件あります',
    body: '次の案件が、未対応・次回期日の超過・進捗の記録がないまま時間がたっている状態です。\n\n' + 行.join('\n') + '\n\n' + (管理画面URL_() ? '管理画面：' + 管理画面URL_() : '') });
}
function 時間表記_(h) { return h >= 24 ? Math.floor(h / 24) + '日' + (h % 24 ? (h % 24) + '時間' : '') : h + '時間'; }

// ===== 取次先ご登録フォームの招待 =====
const 招待見出し = ['合言葉（触らない）', '相手の名前', 'メール', '期限', '送った人', '送った日時', '登録した日時'];
function invitePartner(token, 名前, メール) {
  const me = 確認_(token);
  名前 = String(名前 || '').trim().slice(0, 100); メール = String(メール || '').trim();
  if (!名前) return { ok: false, error: '相手の名前を入れてください。' };
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(メール)) return { ok: false, error: 'メールアドレスの形が正しくありません。' };
  const t = Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, '').slice(0, 8);
  const 期限 = new Date(Date.now() + 14 * 86400000);
  シート_('招待', 招待見出し).appendRow([t, 名前, メール, Utilities.formatDate(期限, 'Asia/Tokyo', 'yyyy/MM/dd HH:mm'), me.名前, 今_(), '']);
  const url = 'https://madvi.jp/kanri/partner.html?t=' + t;
  MailApp.sendEmail({ to: メール, replyTo: 通知先, name: 会社名, subject: '【' + 会社名 + '】提携先のご登録のお願い',
    body: 名前 + ' 様\n\nいつもお世話になっております。' + 会社名 + 'の' + me.名前 + 'です。\n\n当社の取次先（提携先）としてご登録いただくため、下記の専用ページから貴社の情報をご入力ください。\n\n' + url + '\n\n※このページは、このメールを受け取った方専用です。14日間（' + Utilities.formatDate(期限, 'Asia/Tokyo', 'M月d日') + 'まで）有効です。\n※ご入力いただいた内容は、当社で確認したうえで登録いたします。\n\nご不明な点は、このメールへのご返信でお問い合わせください。\n\n────────────────\n' + 署名_() });
  ログ_(me, '-', '取次先の招待', 名前 + '（' + メール + '）', '', '');
  return { ok: true };
}
function 招待を探す_(t) {
  t = String(t || ''); if (!/^[0-9a-f]{40}$/.test(t)) return null;
  const s = シート_('招待', 招待見出し); const n = s.getLastRow(); if (n < 2) return null;
  const v = s.getRange(2, 1, n - 1, 7).getValues(); const i = v.findIndex(r => r[0] === t); if (i < 0) return null;
  const 期限 = 日付_(v[i][3]);
  return { 行: i + 2, 名前: v[i][1], メール: v[i][2], 期限切れ: !期限 || 期限.getTime() < Date.now(), 使用済み: !!v[i][6], 送った人: v[i][4] };
}
function 招待API_(p) {
  const 返す = (obj) => ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
  try {
    const iv = 招待を探す_(p.t);
    if (!iv) return 返す({ ok: false, error: 'このリンクは使えません。届いたメールのリンクをもう一度開いてください。' });
    if (iv.使用済み) return 返す({ ok: false, error: 'このリンクからは、すでにご登録いただいています。ありがとうございました。' });
    if (iv.期限切れ) return 返す({ ok: false, error: 'このリンクの有効期限（14日間）が過ぎています。お手数ですが、当社へご連絡ください。' });
    if (p.pub === 'invite') return 返す({ ok: true, 名前: iv.名前, メール: iv.メール, 分野: 取次分野_ });
    const d = JSON.parse(p.data || '{}');
    const 名前 = String(d.名前 || '').trim().slice(0, 100), メール = String(d.メール || '').trim();
    if (!名前 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(メール) || !d.同意) return 返す({ ok: false, error: '必須の項目を確認してください。' });
    const lock = LockService.getScriptLock(); lock.waitLock(20000);
    try {
      const s = 本体_().getSheetByName('取次先') || シート_('取次先', 取次先見出し);
      let nm = 名前; if (取次先一覧_().some(x => x.名前 === nm)) nm = 名前 + '（' + 今_().slice(0, 10) + ' 登録）';
      const v = [nm, '提携先', d.担当者 || '', d.電話 || '', メール, d.分野 || '', d.キーワード || '', d.地域 || '', d.条件 || '', '確認待ち', d.メモ || '', 今_().slice(0, 10), iv.送った人 + '（招待）', '登録フォーム'].map(x => String(x).slice(0, 1000));
      s.appendRow(v);
      シート_('招待', 招待見出し).getRange(iv.行, 7).setValue(今_());
      ログ_({ 名前: nm }, '-', '取次先の登録（招待）', nm + '（確認待ち）', '', '');
    } finally { lock.releaseLock(); }
    MailApp.sendEmail({ to: 通知先, name: 会社名 + ' 案件管理', subject: '【確認待ち】取次先のご登録がありました：' + 名前, body: '招待した「' + iv.名前 + '」様から、取次先のご登録がありました。\n管理画面の「取次先」で内容を確認し、「確認して使えるようにする」を押してください。\n\n' + 管理画面URL_() });
    return 返す({ ok: true });
  } catch (err) { return 返す({ ok: false, error: '送信できませんでした。時間をおいてお試しください。' }); }
}
const 取次分野_ = ['企業支援・経営サポート', '専門家連携・行政書士業務', '人材・採用支援', '事業連携・協業', '新規事業開発', '通信・電話関連', '店舗運営支援', '固定費・仕入れ削減', '衛生・環境関連商材', '商材開拓・代理店展開', '海外・輸出・国際ネットワーク', '地域活性化', '企画・制作・プロデュース', 'AI・システム開発', 'リユース・買取', '家じまい・不動産支援', '医療・介護 総合支援'];
