  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const sh = 一覧_();
    const 行 = 行を探す_(sh, data.行, data.番号);
    const 区分 = 区分_(sh.getRange(行, 列.相談).getValue(), sh.getRange(行, 列.分野).getValue()); const 定 = 区分定義[区分];
    const r = sh.getRange(行, 1, 1, 見出し.length).getValues()[0];
    const 前 = 旧段階[r[列.状況 - 1]] || r[列.状況 - 1] || '未対応';
    const 変更 = [];
    if (data.状況 && data.状況 !== r[列.状況 - 1]) {
      if (定.段階.indexOf(data.状況) < 0) throw new Error('進み具合の値が正しくありません');
      sh.getRange(行, 列.状況).setValue(data.状況);
      if (data.状況 !== 前) 変更.push('進み具合：' + 前 + '→' + data.状況);
    }
    const 中 = String(data.中分類 || '').slice(0, 100), 小 = String(data.小分類 || '').slice(0, 200);
    if (data.中分類 != null) { sh.getRange(行, 列.進捗中).setValue(中); sh.getRange(行, 列.進捗小).setValue(小); }
    if (data.期日 != null && String(data.期日).replace(/-/g, '/') !== 書式日_(r[列.期日 - 1])) { sh.getRange(行, 列.期日).setNumberFormat('@').setValue(String(data.期日).replace(/-/g, '/')); 変更.push(data.期日 ? '次回期日：' + String(data.期日).replace(/-/g, '/') : '次回期日を解除'); }
    if (data.担当者 != null && data.担当者 !== r[列.担当者 - 1]) { sh.getRange(行, 列.担当者).setValue(data.担当者); 変更.push('担当者：' + (data.担当者 || 'なし')); }
    if (data.担当者 && me.立場 !== '管理者' && data.担当者 !== me.名前) throw new Error('担当者は自分の名前にだけ変えられます。');
    if (data.契約番号 != null && data.契約番号 !== String(r[列.契約番号 - 1] || '')) { sh.getRange(行, 列.契約番号).setNumberFormat('@').setValue(String(data.契約番号).slice(0, 60)); 変更.push('契約番号：' + (data.契約番号 || 'なし')); }
    if (data.契約状態 != null && data.契約状態 !== String(r[列.契約状態 - 1] || '')) { sh.getRange(行, 列.契約状態).setValue(String(data.契約状態).slice(0, 30)); 変更.push('電子契約：' + (data.契約状態 || 'なし')); }
    if (!定.自社のみ && data.振分け先 != null && data.振分け先 !== r[列.振分け先 - 1]) { sh.getRange(行, 列.振分け先).setValue(data.振分け先); 変更.push('取次先：' + data.振分け先); }
    if (data.メモ != null && data.メモ !== r[列.メモ - 1]) sh.getRange(行, 列.メモ).setValue(String(data.メモ).slice(0, 5000));
    const 記録 = String(data.記録 || '').trim().slice(0, 3000);
    const 金額 = String(data.金額 == null ? '' : data.金額).replace(/[^\d.-]/g, '');
    if (変更.length || 記録 || 中 || 金額) {
      sh.getRange(行, 列.最終対応).setNumberFormat('@').setValue(今_());
      本体_().getSheetByName('対応履歴').appendRow([今_(), data.番号, me.名前, '進捗', data.状況 || 前, [変更.join('／'), 記録].filter(Boolean).join('\n'), '', 中, 小, 金額 === '' ? '' : Number(金額)]);
      ログ_(me, data.番号, data.状況 && data.状況 !== 前 ? '段階の変更' : '対応の記録', [変更.join('／'), 中 ? 中 + (小 ? '・' + 小 : '') : '', 記録].filter(Boolean).join('／'), data.担当者 != null ? data.担当者 : r[列.担当者 - 1], 区分);
