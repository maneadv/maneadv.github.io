// ===== 管理画面（madvi.jp/kanri/）からの呼び出し =====
// グーグルに複数のアカウントでログインしていても開けるよう、ホームページ上の管理画面から呼び出す。
const 管理API一覧_ = { login, logout, changePassword, listCases, getHistory, updateCase, draftReport, sendReport, getPartners, savePartner, suggestPartners, draftReferral, sendReferral, getLog, listStaff, saveStaff, invitePartner, approvePartner };
function 管理API_(p) {
  const 返す = (obj) => ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
  const fn = 管理API一覧_[String(p.api)];
  if (!fn) return 返す({ apiError: '使えない操作です' });
  try {
    const args = JSON.parse(p.args || '[]');
    if (!Array.isArray(args)) return 返す({ apiError: '呼び出しの形が正しくありません' });
    return 返す({ r: fn.apply(null, args) });
  } catch (err) {
    return 返す({ apiError: String((err && err.message) || err) });
  }
}
